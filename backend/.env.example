# Local disposable PostGIS database only. Replace credentials for your own setup.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/roadassist
# Generate a unique local value (do not reuse the Compose example secret).
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173
# This currently gates only part of the startup DDL; other installers still run.
AUTO_BOOTSTRAP_SCHEMA=false
# Optional SMTP fields; leave unconfigured for a local demo without email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
